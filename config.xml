<?xml version='1.0' encoding='utf-8'?>
<widget id="com.agnezgrace.chatfiction" version="1.0.0" xmlns="http://www.cordova.io/ns/1.0" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Chat Fiction</name>
    <description>Interactive Chat Fiction Creator &amp; Reader</description>
    <author email="lunarica.official@gmail.com">AgnezGrace / LUNA ICON</author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />

    <preference name="ScrollEnabled" value="true" />
    <preference name="BackupWebStorage" value="none" />
    <preference name="AndroidWindowSplashScreenAnimatedIcon" value="res/transparent.png" />
    <preference name="AndroidWindowSplashScreenBackground" value="@drawable/splash_bg" />
    <preference name="SplashScreenDelay" value="3000" />

    <platform name="android">
        <icon src="res/icon.png" />
        <resource-file src="res/splash.png" target="app/src/main/res/drawable/splash_bg.png" />
    </platform>
</widget>
